@page "/"
@using System.Globalization
@using System.Text
@using System.IO
@using System.Diagnostics
@using proyectoejerciciosescritorio.Application.Services.Pdf
@inject AppDbContext DbContext
@inject RoutineBuilderState RoutineState
@inject ThemeService ThemeState
@inject CommandKeyConfigService KeyConfig
@inject PdfGeneratorService PdfService
@inject IJSRuntime JS
@implements IDisposable

<div class="desktop-shell">
    @* Top Application Bar *@
    <header class="desktop-topbar">
        <div class="brand-group">
            <div class="brand-logo">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <h1 class="brand-title">Creador Rápido de Rutinas</h1>
                <span class="brand-subtitle">Flujo acelerado por comandos de teclado (10–15 min)</span>
            </div>
        </div>

        <div class="routine-title-box" title="Título que aparecerá en el documento PDF">
            <i class="bi bi-file-earmark-medical-fill"></i>
            <input type="text"
                   class="routine-title-input"
                   placeholder="Nombre de la rutina (ej: Hipertrofia Semana 1)..."
                   @bind-value="pdfTitle"
                   @bind-value:event="oninput" />
        </div>

        <div class="topbar-actions">
            <button type="button"
                    class="btn-create-routine @(RoutineState.IsRoutineStarted ? "started" : "pulse-cta")"
                    @onclick="HandleCrearRutinaClick"
                    title="Iniciar rutina en Día 1 y comenzar a escribir ejercicios">
                <i class="bi bi-play-circle-fill"></i>
                @(RoutineState.IsRoutineStarted ? "Reiniciar / Crear Rutina" : "Crear Rutina")
            </button>

            <button type="button"
                    class="btn-toggle-catalog @(showKeySettingsModal ? "active" : "")"
                    @onclick="OpenKeySettingsModal"
                    title="Configurar las teclas para cada comando">
                <i class="bi bi-gear-fill"></i>
                Configuración
            </button>

            <button type="button"
                    class="btn-toggle-catalog @(showCatalogSidebar ? "active" : "")"
                    @onclick="() => showCatalogSidebar = !showCatalogSidebar"
                    title="Mostrar u ocultar el catálogo completo y editor de ejercicios">
                <i class="bi bi-collection-fill"></i>
                Catálogo (@allExercises.Count)
            </button>

            <button type="button"
                    class="btn-theme-toggle"
                    @onclick="ToggleTheme"
                    title="Alternar tema claro / oscuro">
                <i class="bi @(ThemeState.IsDarkMode ? "bi-sun-fill" : "bi-moon-stars-fill")"></i>
            </button>

            <button type="button"
                    class="btn-export-pdf"
                    @onclick="OpenPdfModal"
                    title="Generar y guardar PDF de la rutina">
                <i class="bi bi-file-earmark-pdf-fill"></i> Exportar PDF
            </button>
        </div>
    </header>

    @* Command Bar HUD: Interactive Buttons + Keyboard Shortcuts *@
    <section class="command-hud-bar">
        <div class="hud-status-indicator">
            <span class="status-dot @GetFlowStateCss()"></span>
            <span class="status-label">@GetFlowStateTitle()</span>
        </div>

        <div class="command-buttons-group">
            <button type="button"
                    class="cmd-key-btn @(flowState == FlowState.TypingExercise ? "active-cmd" : "")"
                    @onclick="ActivateExerciseCommand"
                    title="Atajo actual para Ejercicio: @KeyConfig.ExerciseKey.Display">
                <kbd class="key-cap">@KeyConfig.ExerciseKey.Display</kbd>
                <span class="cmd-name"><i class="bi bi-lightning-charge-fill"></i> Ejercicio</span>
            </button>

            <button type="button"
                    class="cmd-key-btn @(flowState == FlowState.TypingLabel ? "active-cmd" : "")"
                    @onclick="ActivateLabelCommand"
                    title="Atajo actual para Etiqueta: @KeyConfig.LabelKey.Display">
                <kbd class="key-cap">@KeyConfig.LabelKey.Display</kbd>
                <span class="cmd-name"><i class="bi bi-tag-fill"></i> Etiqueta</span>
            </button>

            <button type="button"
                    class="cmd-key-btn"
                    @onclick="ActivateNextDayCommand"
                    title="Atajo actual para Siguiente Día: @KeyConfig.NextDayKey.Display">
                <kbd class="key-cap">@KeyConfig.NextDayKey.Display</kbd>
                <span class="cmd-name"><i class="bi bi-calendar-plus-fill"></i> Siguiente Día</span>
            </button>

            <button type="button"
                    class="cmd-key-btn @(flowState == FlowState.TypingSeries || flowState == FlowState.TypingReps ? "active-cmd" : "")"
                    @onclick="ActivateEnterCommand"
                    title="Atajo actual para Selección: @KeyConfig.SelectKey.Display">
                <kbd class="key-cap">@KeyConfig.SelectKey.Display</kbd>
                <span class="cmd-name"><i class="bi bi-check2-circle"></i> Selección</span>
            </button>

            <button type="button"
                    class="cmd-config-mini-btn"
                    @onclick="OpenKeySettingsModal"
                    title="Personalizar teclas de comandos">
                <i class="bi bi-sliders"></i> Teclas
            </button>
        </div>
    </section>

    @* Main Desktop Workspace: Left = Command Console + Routine Days, Right = Exercise Catalog & Muscle Groups *@
    <div class="desktop-workspace">
        <div class="routine-builder-column">
            @if (!RoutineState.IsRoutineStarted)
            {
                @* Initial Welcome / Fast Start Screen *@
                <div class="welcome-start-card">
                    <div class="welcome-icon-ring">
                        <i class="bi bi-keyboard-fill"></i>
                    </div>
                    <h2>Optimiza la creación de tus rutinas semanales</h2>
                    <p>
                        Diseñado para escribir toda la rutina sin depender del mouse. Haz clic en
                        <strong>Crear Rutina</strong> para abrir el <strong>Día 1</strong> y comenzar a escribir ejercicios al instante.
                    </p>

                    <div class="welcome-shortcuts-grid">
                        <div class="shortcut-box">
                            <kbd>@KeyConfig.ExerciseKey.Display</kbd>
                            <span>Buscar e insertar <strong>Ejercicio</strong></span>
                        </div>
                        <div class="shortcut-box">
                            <kbd>@KeyConfig.SelectKey.Display</kbd>
                            <span><strong>Seleccionar</strong> ejercicio y confirmar series/reps</span>
                        </div>
                        <div class="shortcut-box">
                            <kbd>@KeyConfig.LabelKey.Display</kbd>
                            <span>Crear <strong>Etiqueta</strong> (ej. Superserie, Descanso)</span>
                        </div>
                        <div class="shortcut-box">
                            <kbd>@KeyConfig.NextDayKey.Display</kbd>
                            <span>Pasar al <strong>Siguiente Día</strong> (Día 2, Día 3...)</span>
                        </div>
                    </div>

                    <div class="welcome-actions-row">
                        <button type="button" class="btn-hero-start" @onclick="StartNewRoutineFlow">
                            <i class="bi bi-play-fill"></i> Crear Rutina Ahora (Comenzar en Día 1)
                        </button>
                        <button type="button" class="btn-hero-config" @onclick="OpenKeySettingsModal">
                            <i class="bi bi-gear-fill"></i> Configurar Teclas de Comandos
                        </button>
                    </div>
                </div>
            }
            else
            {
                @* Active Command Console *@
                <div class="active-command-console @GetFlowStateCss()">
                    <div class="console-header-row">
                        <div class="console-day-badge">
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>Editando: <strong>@(RoutineState.ActiveDia?.Nombre ?? "Día 1")</strong></span>
                        </div>
                        <div class="console-step-breadcrumb">
                            <span class="step-pill @(flowState == FlowState.TypingExercise ? "current" : "")">1. Ejercicio (@KeyConfig.ExerciseKey.Display)</span>
                            <i class="bi bi-chevron-right"></i>
                            <span class="step-pill @(flowState == FlowState.TypingSeries || flowState == FlowState.TypingReps ? "current" : "")">2. Series y Reps (@KeyConfig.SelectKey.Display)</span>
                            <i class="bi bi-chevron-right"></i>
                            <span class="step-pill @(flowState == FlowState.WaitingCommand ? "current" : "")">3. Siguiente Comando</span>
                        </div>
                    </div>

                    @if (flowState == FlowState.TypingExercise)
                    {
                        <div class="console-exercise-search">
                            <div class="search-input-wrapper">
                                <i class="bi bi-search search-lead-icon"></i>
                                <input id="cmd-exercise-input"
                                       data-command-input="exercise"
                                       type="text"
                                       class="cmd-main-input"
                                       placeholder="Escribe el ejercicio (ej: press inclinado, sentadilla)... o presiona (@KeyConfig.LabelKey.Display) Etiqueta / (@KeyConfig.NextDayKey.Display) Siguiente Día"
                                       @bind-value="exerciseSearchText"
                                       @bind-value:event="oninput"
                                       @onkeydown="HandleExerciseInputKeyDown"
                                       autocomplete="off" />
                                <button type="button" class="btn-inline-confirm" @onclick="ConfirmSelectedExercise">
                                    <kbd>@KeyConfig.SelectKey.Display</kbd> Insertar
                                </button>
                            </div>

                            @{
                                var matches = MatchedExercises;
                                var bestMatch = matches.ElementAtOrDefault(selectedSuggestionIndex) ?? matches.FirstOrDefault();
                            }

                            @if (bestMatch != null)
                            {
                                <div class="best-match-showcase" @onclick="() => InsertExerciseAndGoToSeries(bestMatch)">
                                    <div class="best-match-badge">
                                        <i class="bi bi-stars"></i> Mejor coincidencia — Presiona <kbd>@KeyConfig.SelectKey.Display</kbd> para insertar
                                    </div>
                                    <div class="best-match-content">
                                        @if (!string.IsNullOrWhiteSpace(bestMatch.RutaImagen))
                                        {
                                            <img src="@ImageHelper.GetImageSrc(bestMatch.RutaImagen)"
                                                 alt="@bestMatch.Nombre"
                                                 class="best-match-img"
                                                 onerror="this.style.display='none'" />
                                        }
                                        else
                                        {
                                            <div class="best-match-placeholder">
                                                <i class="bi bi-lightning-charge-fill"></i>
                                            </div>
                                        }
                                        <div class="best-match-info">
                                            <div class="best-match-name">@bestMatch.Nombre</div>
                                            <div class="best-match-group">
                                                <i class="bi bi-layers-fill"></i> @bestMatch.GrupoMuscular
                                            </div>
                                        </div>
                                        <div class="best-match-cta">
                                            <span>Insertar en @(RoutineState.ActiveDia?.Nombre)</span>
                                            <kbd>@KeyConfig.SelectKey.Display</kbd>
                                        </div>
                                    </div>
                                </div>

                                @if (matches.Count > 1)
                                {
                                    <div class="other-matches-strip">
                                        <span class="strip-label">Otras sugerencias (<kbd>↑</kbd> <kbd>↓</kbd> o clic):</span>
                                        <div class="suggestions-list">
                                            @for (int i = 0; i < Math.Min(matches.Count, 6); i++)
                                            {
                                                var idx = i;
                                                var sug = matches[idx];
                                                <button type="button"
                                                        class="suggestion-chip @(idx == selectedSuggestionIndex ? "selected" : "")"
                                                        @onclick="() => InsertExerciseAndGoToSeries(sug)">
                                                    <span class="chip-name">@sug.Nombre</span>
                                                    <span class="chip-group">@sug.GrupoMuscular</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="no-match-box">
                                    <span>No se encontró un ejercicio similar a "<strong>@exerciseSearchText</strong>".</span>
                                    <button type="button" class="btn-quick-create-from-search" @onclick="QuickCreateExerciseFromSearch">
                                        <i class="bi bi-plus-circle-fill"></i> Crear "@exerciseSearchText" e insertarlo
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else if (flowState == FlowState.TypingSeries || flowState == FlowState.TypingReps)
                    {
                        <div class="console-series-reps-box">
                            <div class="pending-exercise-summary">
                                @if (!string.IsNullOrWhiteSpace(pendingItem?.Ejercicio?.RutaImagen))
                                {
                                    <img src="@ImageHelper.GetImageSrc(pendingItem.Ejercicio.RutaImagen)"
                                         alt="@pendingItem.Ejercicio.Nombre"
                                         class="pending-ex-img" />
                                }
                                <div>
                                    <span class="pending-ex-badge">Ejercicio insertado en @(RoutineState.ActiveDia?.Nombre)</span>
                                    <h4 class="pending-ex-title">@(pendingItem?.Ejercicio?.Nombre ?? "Ejercicio")</h4>
                                </div>
                            </div>

                            <div class="series-reps-inputs-row">
                                <div class="sr-field-box @(flowState == FlowState.TypingSeries ? "focused-field" : "")">
                                    <label>1. SERIES <small>(o escribe 4x12)</small></label>
                                    <input id="cmd-series-input"
                                           data-command-input="series"
                                           type="text"
                                           class="sr-big-input"
                                           @bind-value="seriesInputText"
                                           @bind-value:event="oninput"
                                           @onkeydown="HandleSeriesKeyDown" />
                                </div>

                                <div class="sr-multiply-icon">
                                    <i class="bi bi-x-lg"></i>
                                </div>

                                <div class="sr-field-box @(flowState == FlowState.TypingReps ? "focused-field" : "")">
                                    <label>2. REPETICIONES</label>
                                    <input id="cmd-reps-input"
                                           data-command-input="reps"
                                           type="text"
                                           class="sr-big-input"
                                           @bind-value="repsInputText"
                                           @bind-value:event="oninput"
                                           @onkeydown="HandleRepsKeyDown" />
                                </div>

                                <button type="button" class="btn-confirm-sr" @onclick="ConfirmSeriesAndReps">
                                    <kbd>@KeyConfig.SelectKey.Display</kbd> Confirmar
                                </button>
                            </div>
                        </div>
                    }
                    else if (flowState == FlowState.TypingLabel)
                    {
                        <div class="console-label-box">
                            <div class="search-input-wrapper label-mode-wrapper">
                                <i class="bi bi-tag-fill label-lead-icon"></i>
                                <input id="cmd-label-input"
                                       data-command-input="label"
                                       type="text"
                                       class="cmd-main-input"
                                       placeholder="Escribe el texto de la etiqueta (ej: Superserie, Descanso 90s, Calentamiento) y presiona @KeyConfig.SelectKey.Display..."
                                       @bind-value="labelInputText"
                                       @bind-value:event="oninput"
                                       @onkeydown="HandleLabelKeyDown" />
                                <button type="button" class="btn-inline-confirm" @onclick="ConfirmLabelInput">
                                    <kbd>@KeyConfig.SelectKey.Display</kbd> Guardar Etiqueta
                                </button>
                            </div>
                        </div>
                    }
                    else if (flowState == FlowState.WaitingCommand)
                    {
                        <div class="console-waiting-box">
                            <div class="waiting-title">
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span>¡Listo! Esperando siguiente comando en <strong>@(RoutineState.ActiveDia?.Nombre)</strong>:</span>
                            </div>
                            <div class="waiting-cards-row">
                                <div class="waiting-cmd-card" @onclick="ActivateExerciseCommand">
                                    <kbd>@KeyConfig.ExerciseKey.Display</kbd>
                                    <span>Agregar otro <strong>Ejercicio</strong></span>
                                </div>
                                <div class="waiting-cmd-card" @onclick="ActivateLabelCommand">
                                    <kbd>@KeyConfig.LabelKey.Display</kbd>
                                    <span>Insertar una <strong>Etiqueta</strong></span>
                                </div>
                                <div class="waiting-cmd-card" @onclick="ActivateNextDayCommand">
                                    <kbd>@KeyConfig.NextDayKey.Display</kbd>
                                    <span>Pasar al <strong>Siguiente Día</strong></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Day Tabs Strip *@
                <div class="days-tabs-bar">
                    @foreach (var dia in RoutineState.Dias)
                    {
                        var count = RoutineState.RoutineItems.Count(i => i.DiaId == dia.Id);
                        var isCurrent = RoutineState.ActiveDiaId == dia.Id;
                        <button type="button"
                                class="day-tab-pill @(isCurrent ? "active" : "")"
                                @onclick="() => SelectDayFromUI(dia.Id)">
                            <i class="bi bi-calendar2-day"></i>
                            <span>@dia.Nombre</span>
                            <span class="day-tab-count">@count</span>
                        </button>
                    }
                    <button type="button" class="day-tab-add" @onclick="ActivateNextDayCommand" title="Atajo: tecla @KeyConfig.NextDayKey.Display">
                        <i class="bi bi-plus-lg"></i> Siguiente Día (<kbd>@KeyConfig.NextDayKey.Display</kbd>)
                    </button>
                </div>

                @* Multi-Day Routine Board *@
                <div class="desktop-days-grid">
                    @foreach (var dia in RoutineState.Dias)
                    {
                        var isCurrent = RoutineState.ActiveDiaId == dia.Id;
                        var itemsInDay = RoutineState.RoutineItems
                            .Where(i => i.DiaId == dia.Id)
                            .OrderBy(i => i.OrdenVisual)
                            .ToList();

                        <div id="desktop-day-@dia.Id"
                             class="desktop-day-card @(isCurrent ? "active-day-card" : "")"
                             @onclick="() => SelectDayFromUI(dia.Id)">
                            <div class="day-card-header">
                                <div class="day-card-title-group">
                                    <span class="active-indicator-badge">
                                        <i class="bi @(isCurrent ? "bi-record-circle-fill" : "bi-circle")"></i>
                                    </span>
                                    <input type="text"
                                           class="day-name-editable"
                                           @bind-value="dia.Nombre"
                                           @bind-value:event="oninput"
                                           title="Haz clic para cambiar el nombre del día" />
                                    <span class="day-items-badge">@itemsInDay.Count ítems</span>
                                </div>
                                <div class="day-card-actions" @onclick:stopPropagation="true">
                                    <button type="button"
                                            class="btn-day-action"
                                            title="Escribir ejercicio en este día (@KeyConfig.ExerciseKey.Display)"
                                            @onclick="() => StartExerciseInDay(dia.Id)">
                                        <i class="bi bi-plus-lg"></i> Ejercicio
                                    </button>
                                    <button type="button"
                                            class="btn-day-action label-action"
                                            title="Agregar etiqueta en este día (@KeyConfig.LabelKey.Display)"
                                            @onclick="() => StartLabelInDay(dia.Id)">
                                        <i class="bi bi-tag-fill"></i> Etiqueta
                                    </button>
                                    @if (RoutineState.Dias.Count > 1)
                                    {
                                        <button type="button"
                                                class="btn-day-delete"
                                                title="Eliminar día"
                                                @onclick="() => RoutineState.RemoveDay(dia.Id)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="day-card-body">
                                @if (!itemsInDay.Any())
                                {
                                    <div class="day-empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span>Sin elementos todavía. Presiona <kbd>@KeyConfig.ExerciseKey.Display</kbd> para agregar un ejercicio o <kbd>@KeyConfig.LabelKey.Display</kbd> para una etiqueta.</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="day-items-table">
                                        @for (int i = 0; i < itemsInDay.Count; i++)
                                        {
                                            var idx = i;
                                            var item = itemsInDay[idx];
                                            var isPending = pendingItem?.Id == item.Id && (flowState == FlowState.TypingSeries || flowState == FlowState.TypingReps);

                                            @if (item.EsEtiqueta)
                                            {
                                                <div class="routine-row label-row" @key="item.Id" @onclick:stopPropagation="true">
                                                    <span class="row-index-badge label-idx">#@(idx + 1)</span>
                                                    <i class="bi bi-tag-fill label-row-icon"></i>
                                                    <input type="text"
                                                           class="inline-label-input"
                                                           @bind-value="item.TextoEtiqueta"
                                                           @bind-value:event="oninput" />
                                                    <div class="row-quick-btns">
                                                        <button type="button" disabled="@(idx == 0)" @onclick="() => RoutineState.MoveItemStep(item.Id, -1)" title="Subir"><i class="bi bi-arrow-up"></i></button>
                                                        <button type="button" disabled="@(idx == itemsInDay.Count - 1)" @onclick="() => RoutineState.MoveItemStep(item.Id, 1)" title="Bajar"><i class="bi bi-arrow-down"></i></button>
                                                        <button type="button" class="danger" @onclick="() => RoutineState.RemoveItem(item.Id)" title="Eliminar"><i class="bi bi-x-lg"></i></button>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="routine-row exercise-row @(isPending ? "editing-now" : "")" @key="item.Id" @onclick:stopPropagation="true">
                                                    <span class="row-index-badge">#@(idx + 1)</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.Ejercicio?.RutaImagen))
                                                    {
                                                        <img src="@ImageHelper.GetImageSrc(item.Ejercicio.RutaImagen)"
                                                             alt="@item.Ejercicio.Nombre"
                                                             class="row-ex-thumb"
                                                             onerror="this.style.display='none'" />
                                                    }
                                                    else
                                                    {
                                                        <div class="row-ex-placeholder">
                                                            <i class="bi bi-lightning-charge-fill"></i>
                                                        </div>
                                                    }

                                                    <div class="row-ex-main">
                                                        <div class="row-ex-name">@item.Ejercicio?.Nombre</div>
                                                        <span class="row-ex-group">@item.Ejercicio?.GrupoMuscular</span>
                                                    </div>

                                                    <div class="row-sr-controls">
                                                        <label>
                                                            <span>Series</span>
                                                            <input type="number"
                                                                   min="1"
                                                                   class="inline-num-input"
                                                                   @bind-value="item.Series"
                                                                   @bind-value:event="oninput" />
                                                        </label>
                                                        <span class="sr-sep">×</span>
                                                        <label>
                                                            <span>Reps</span>
                                                            <input type="number"
                                                                   min="1"
                                                                   class="inline-num-input"
                                                                   @bind-value="item.Repeticiones"
                                                                   @bind-value:event="oninput" />
                                                        </label>
                                                    </div>

                                                    <div class="row-quick-btns">
                                                        <button type="button" disabled="@(idx == 0)" @onclick="() => RoutineState.MoveItemStep(item.Id, -1)" title="Subir"><i class="bi bi-arrow-up"></i></button>
                                                        <button type="button" disabled="@(idx == itemsInDay.Count - 1)" @onclick="() => RoutineState.MoveItemStep(item.Id, 1)" title="Bajar"><i class="bi bi-arrow-down"></i></button>
                                                        <button type="button" class="danger" @onclick="() => RoutineState.RemoveItem(item.Id)" title="Eliminar"><i class="bi bi-x-lg"></i></button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Right Sidebar: Full Exercise & Muscle Group Catalog Manager *@
        @if (showCatalogSidebar)
        {
            <aside class="catalog-sidebar-column">
                <ExerciseCatalogManager Ejercicios="allExercises"
                                        OnCatalogUpdated="ReloadCatalog"
                                        OnQuickSelectExercise="HandleCatalogQuickInsert" />
            </aside>
        }
    </div>
</div>

@* Modal de Configuración de Teclas de Comandos *@
@if (showKeySettingsModal)
{
    <div class="pdf-modal-backdrop" @onclick="CloseKeySettingsModal">
        <div class="settings-modal-card" @onclick:stopPropagation="true">
            <div class="pdf-modal-header">
                <h3><i class="bi bi-gear-fill"></i> Configuración de Teclas de Comandos</h3>
                <button type="button" class="pdf-modal-close" @onclick="CloseKeySettingsModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <p class="pdf-modal-desc">
                Haz clic en <strong>Cambiar tecla</strong> junto al comando que desees personalizar y luego presiona la nueva tecla en tu teclado:
            </p>

            <div class="keybindings-list">
                @* 1. Ejercicio *@
                <div class="keybinding-row @(capturingCommandId == "SHIFT_RIGHT" ? "capturing" : "")">
                    <div class="kb-info">
                        <div class="kb-title"><i class="bi bi-lightning-charge-fill"></i> Comando: Ejercicio</div>
                        <div class="kb-sub">Activa el buscador para escribir e insertar un ejercicio</div>
                    </div>
                    <div class="kb-actions">
                        <kbd class="kb-badge">@KeyConfig.ExerciseKey.Display</kbd>
                        @if (capturingCommandId == "SHIFT_RIGHT")
                        {
                            <button type="button" class="btn-kb-listening" @onclick="CancelKeyCaptureAsync">
                                <i class="bi bi-record-circle-fill"></i> Presiona una tecla... (Esc cancelar)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-kb-change" @onclick='() => StartKeyCaptureAsync("SHIFT_RIGHT")'>
                                <i class="bi bi-keyboard"></i> Cambiar tecla
                            </button>
                        }
                    </div>
                </div>

                @* 2. Etiqueta *@
                <div class="keybinding-row @(capturingCommandId == "LABEL" ? "capturing" : "")">
                    <div class="kb-info">
                        <div class="kb-title"><i class="bi bi-tag-fill"></i> Comando: Etiqueta</div>
                        <div class="kb-sub">Inserta una nota o etiqueta (Superserie, Descanso, etc.)</div>
                    </div>
                    <div class="kb-actions">
                        <kbd class="kb-badge">@KeyConfig.LabelKey.Display</kbd>
                        @if (capturingCommandId == "LABEL")
                        {
                            <button type="button" class="btn-kb-listening" @onclick="CancelKeyCaptureAsync">
                                <i class="bi bi-record-circle-fill"></i> Presiona una tecla... (Esc cancelar)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-kb-change" @onclick='() => StartKeyCaptureAsync("LABEL")'>
                                <i class="bi bi-keyboard"></i> Cambiar tecla
                            </button>
                        }
                    </div>
                </div>

                @* 3. Siguiente Día *@
                <div class="keybinding-row @(capturingCommandId == "NEXT_DAY" ? "capturing" : "")">
                    <div class="kb-info">
                        <div class="kb-title"><i class="bi bi-calendar-plus-fill"></i> Comando: Siguiente Día</div>
                        <div class="kb-sub">Crea o avanza al siguiente día de entrenamiento (Día 2, Día 3...)</div>
                    </div>
                    <div class="kb-actions">
                        <kbd class="kb-badge">@KeyConfig.NextDayKey.Display</kbd>
                        @if (capturingCommandId == "NEXT_DAY")
                        {
                            <button type="button" class="btn-kb-listening" @onclick="CancelKeyCaptureAsync">
                                <i class="bi bi-record-circle-fill"></i> Presiona una tecla... (Esc cancelar)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-kb-change" @onclick='() => StartKeyCaptureAsync("NEXT_DAY")'>
                                <i class="bi bi-keyboard"></i> Cambiar tecla
                            </button>
                        }
                    </div>
                </div>

                @* 4. Selección *@
                <div class="keybinding-row @(capturingCommandId == "ENTER" ? "capturing" : "")">
                    <div class="kb-info">
                        <div class="kb-title"><i class="bi bi-check2-circle"></i> Comando: Selección / Confirmar</div>
                        <div class="kb-sub">Inserta el ejercicio elegido y confirma series, repeticiones o etiquetas</div>
                    </div>
                    <div class="kb-actions">
                        <kbd class="kb-badge">@KeyConfig.SelectKey.Display</kbd>
                        @if (capturingCommandId == "ENTER")
                        {
                            <button type="button" class="btn-kb-listening" @onclick="CancelKeyCaptureAsync">
                                <i class="bi bi-record-circle-fill"></i> Presiona una tecla... (Esc cancelar)
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-kb-change" @onclick='() => StartKeyCaptureAsync("ENTER")'>
                                <i class="bi bi-keyboard"></i> Cambiar tecla

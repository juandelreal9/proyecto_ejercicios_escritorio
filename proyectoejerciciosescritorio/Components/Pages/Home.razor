            </div>

            <div class="settings-modal-footer">
                <button type="button" class="btn-reset-defaults" @onclick="ResetDefaultKeysAsync">
                    <i class="bi bi-arrow-counterclockwise"></i> Restaurar por defecto (Shift Der, -, ¿, Enter)
                </button>
                <button type="button" class="btn-modal-confirm" @onclick="CloseKeySettingsModal">
                    <i class="bi bi-check-lg"></i> Listo

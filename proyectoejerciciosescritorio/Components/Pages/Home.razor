@code {
    private enum FlowState
    {
        NotStarted,
        TypingExercise,
        TypingSeries,
        TypingReps,
        TypingLabel,
        WaitingCommand
    }

    private FlowState flowState = FlowState.NotStarted;
    private List<Ejercicio> allExercises = new();
    private bool showCatalogSidebar = true;
    private bool showPdfModal = false;
    private bool showKeySettingsModal = false;
    private string? capturingCommandId = null;
    private string pdfTitle = "Mi Plan de Entrenamiento";

    private string exerciseSearchText = string.Empty;
    private int selectedSuggestionIndex = 0;
    private ItemRutina? pendingItem = null;
    private string seriesInputText = "4";
    private string repsInputText = "12";
    private string labelInputText = string.Empty;

    private DotNetObjectReference<Home>? dotNetRef;

    protected override void OnInitialized()
    {
        allExercises = DbContext.Ejercicios.ToList();
        RoutineState.OnStateChanged += StateHasChanged;
        ThemeState.OnThemeChanged += StateHasChanged;
        KeyConfig.OnBindingsChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await KeyConfig.InitializeAsync();
            await JS.InvokeVoidAsync("registerDesktopCommandHotkeys", dotNetRef);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        RoutineState.OnStateChanged -= StateHasChanged;
        ThemeState.OnThemeChanged -= StateHasChanged;
        KeyConfig.OnBindingsChanged -= StateHasChanged;
        dotNetRef?.Dispose();
    }

    private void OpenKeySettingsModal()
    {
        capturingCommandId = null;
        showKeySettingsModal = true;
    }

    private async Task CloseKeySettingsModal()
    {
        capturingCommandId = null;
        showKeySettingsModal = false;
        await JS.InvokeVoidAsync("window.cancelListeningForCommandKey");
    }

    private async Task StartKeyCaptureAsync(string commandId)
    {
        capturingCommandId = commandId;
        await JS.InvokeVoidAsync("window.startListeningForCommandKey", commandId);
    }

    private async Task CancelKeyCaptureAsync()
    {
        capturingCommandId = null;
        await JS.InvokeVoidAsync("window.cancelListeningForCommandKey");
    }

    private async Task ResetDefaultKeysAsync()
    {
        capturingCommandId = null;
        await JS.InvokeVoidAsync("window.cancelListeningForCommandKey");
        await KeyConfig.ResetToDefaultsAsync();
    }

    [JSInvokable]
    public async Task OnCapturedCommandKey(string commandId, string key, string code, string display)
    {
        capturingCommandId = null;
        await KeyConfig.UpdateBindingAsync(commandId, key, code, display);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCancelCaptureCommandKey()
    {
        capturingCommandId = null;
        StateHasChanged();
    }

    private void ReloadCatalog()
    {
        allExercises = DbContext.Ejercicios.ToList();
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        await ThemeState.ToggleThemeAsync();
    }

    private async Task HandleCrearRutinaClick()
    {
        if (!RoutineState.IsRoutineStarted)
        {
            await StartNewRoutineFlow();
        }
        else
        {
            bool confirm = await JS.InvokeAsync<bool>("confirm", "¿Deseas reiniciar la rutina actual y comenzar desde Día 1?");
            if (confirm)
            {
                RoutineState.ResetAndStartNewRoutine();
                await EnterTypingExerciseState();
            }
        }
    }

    private async Task StartNewRoutineFlow()
    {
        RoutineState.StartRoutine();
        await EnterTypingExerciseState();
    }

    private async Task EnterTypingExerciseState()
    {
        flowState = FlowState.TypingExercise;
        exerciseSearchText = string.Empty;
        selectedSuggestionIndex = 0;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("focusElementById", "cmd-exercise-input", true);
    }

    private async Task EnterTypingLabelState()
    {
        if (!RoutineState.IsRoutineStarted)
        {
            RoutineState.StartRoutine();
        }
        flowState = FlowState.TypingLabel;
        labelInputText = string.Empty;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("focusElementById", "cmd-label-input", true);
    }

    [JSInvokable]
    public async Task HandleGlobalCommandKey(string command)
    {
        switch (command)
        {
            case "SHIFT_RIGHT":
                await ActivateExerciseCommand();
                break;

            case "LABEL":
                await ActivateLabelCommand();
                break;

            case "NEXT_DAY":
                await ActivateNextDayCommand();
                break;

            case "ENTER":
                await ActivateEnterCommand();
                break;
        }
    }

    private async Task ActivateExerciseCommand()
    {
        if (!RoutineState.IsRoutineStarted)
        {
            RoutineState.StartRoutine();
        }
        await EnterTypingExerciseState();
    }

    private async Task ActivateLabelCommand()
    {
        await EnterTypingLabelState();
    }

    private async Task ActivateNextDayCommand()
    {
        var nextDia = RoutineState.AdvanceOrCreateNextDay();
        flowState = FlowState.WaitingCommand;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("scrollDayIntoView", nextDia.Id);
    }

    private async Task ActivateEnterCommand()
    {
        if (!RoutineState.IsRoutineStarted)
        {
            await StartNewRoutineFlow();
            return;
        }

        if (flowState == FlowState.TypingExercise)
        {
            await ConfirmSelectedExercise();
        }
        else if (flowState == FlowState.TypingSeries)
        {
            await AdvanceFromSeriesToReps();
        }
        else if (flowState == FlowState.TypingReps)
        {
            await ConfirmSeriesAndReps();
        }
        else if (flowState == FlowState.TypingLabel)
        {
            await ConfirmLabelInput();
        }
        else if (flowState == FlowState.WaitingCommand)
        {
            await EnterTypingExerciseState();
        }
    }

    private async Task HandleExerciseInputKeyDown(KeyboardEventArgs e)
    {
        var matches = MatchedExercises;

        if (e.Key == "ArrowDown")
        {
            if (matches.Count > 0)
            {
                selectedSuggestionIndex = (selectedSuggestionIndex + 1) % Math.Min(matches.Count, 6);
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (matches.Count > 0)
            {
                int max = Math.Min(matches.Count, 6);
                selectedSuggestionIndex = (selectedSuggestionIndex - 1 + max) % max;
            }
        }
        else if (e.Key == "Enter")
        {
            await ConfirmSelectedExercise();
        }
        else if (e.Key == "Escape")
        {
            flowState = FlowState.WaitingCommand;
        }
        else
        {
            selectedSuggestionIndex = 0;
        }
    }

    private async Task ConfirmSelectedExercise()
    {
        var matches = MatchedExercises;
        var chosen = matches.ElementAtOrDefault(selectedSuggestionIndex) ?? matches.FirstOrDefault();
        if (chosen != null)
        {
            await InsertExerciseAndGoToSeries(chosen);
        }
        else if (!string.IsNullOrWhiteSpace(exerciseSearchText))
        {
            await QuickCreateExerciseFromSearch();
        }
    }

    private async Task QuickCreateExerciseFromSearch()
    {
        if (string.IsNullOrWhiteSpace(exerciseSearchText)) return;

        var newEx = new Ejercicio
        {
            Nombre = exerciseSearchText.Trim(),
            GrupoMuscular = "General",
            RutaImagen = string.Empty
        };
        DbContext.Ejercicios.Add(newEx);
        DbContext.SaveChanges();
        allExercises = DbContext.Ejercicios.ToList();

        await InsertExerciseAndGoToSeries(newEx);
    }

    private async Task InsertExerciseAndGoToSeries(Ejercicio ejercicio)
    {
        var dia = RoutineState.StartRoutine();
        pendingItem = RoutineState.AddExerciseToDay(ejercicio, dia.Id, 4, 12);
        seriesInputText = pendingItem.Series.ToString();
        repsInputText = pendingItem.Repeticiones.ToString();
        flowState = FlowState.TypingSeries;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("focusElementById", "cmd-series-input", true);
    }

    private async Task HandleCatalogQuickInsert(Ejercicio ejercicio)
    {
        await InsertExerciseAndGoToSeries(ejercicio);
    }

    private async Task HandleSeriesKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AdvanceFromSeriesToReps();
        }
        else if (e.Key == "Escape")
        {
            flowState = FlowState.WaitingCommand;
        }
    }

    private async Task AdvanceFromSeriesToReps()
    {
        if (TryParseCombinedSetsReps(seriesInputText, out int parsedSets, out int parsedReps))
        {
            if (pendingItem != null)
            {
                RoutineState.UpdateExerciseSetsReps(pendingItem.Id, parsedSets, parsedReps);
            }
            pendingItem = null;
            flowState = FlowState.WaitingCommand;
            StateHasChanged();
            return;
        }

        if (int.TryParse(seriesInputText.Trim(), out int s) && s > 0 && pendingItem != null)
        {
            pendingItem.Series = s;
        }

        flowState = FlowState.TypingReps;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("focusElementById", "cmd-reps-input", true);
    }

    private async Task HandleRepsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConfirmSeriesAndReps();
        }
        else if (e.Key == "Escape")
        {
            flowState = FlowState.WaitingCommand;
        }
    }

    private Task ConfirmSeriesAndReps()
    {
        if (pendingItem != null)
        {
            int s = int.TryParse(seriesInputText.Trim(), out int parsedS) && parsedS > 0 ? parsedS : pendingItem.Series;
            int r = int.TryParse(repsInputText.Trim(), out int parsedR) && parsedR > 0 ? parsedR : pendingItem.Repeticiones;
            RoutineState.UpdateExerciseSetsReps(pendingItem.Id, s, r);
        }

        pendingItem = null;
        flowState = FlowState.WaitingCommand;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConfirmLabelInput();
        }
        else if (e.Key == "Escape")
        {
            flowState = FlowState.WaitingCommand;
        }
    }

    private Task ConfirmLabelInput()
    {
        var dia = RoutineState.StartRoutine();
        string texto = string.IsNullOrWhiteSpace(labelInputText) ? "Nota / Indicación" : labelInputText.Trim();
        RoutineState.AddLabelToDay(texto, dia.Id);
        labelInputText = string.Empty;
        flowState = FlowState.WaitingCommand;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SelectDayFromUI(string diaId)
    {
        RoutineState.SelectDay(diaId);
    }

    private async Task StartExerciseInDay(string diaId)
    {
        RoutineState.SelectDay(diaId);
        await EnterTypingExerciseState();
    }

    private async Task StartLabelInDay(string diaId)
    {
        RoutineState.SelectDay(diaId);
        await EnterTypingLabelState();
    }

    private static bool TryParseCombinedSetsReps(string raw, out int sets, out int reps)
    {
        sets = 0;
        reps = 0;
        if (string.IsNullOrWhiteSpace(raw)) return false;

        var parts = raw.ToLowerInvariant().Split(new[] { 'x', '*', '-', ' ', '/' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 2 &&
            int.TryParse(parts[0], out int s) && s > 0 &&
            int.TryParse(parts[1], out int r) && r > 0)
        {
            sets = s;
            reps = r;
            return true;
        }
        return false;
    }

    private List<Ejercicio> MatchedExercises
    {
        get
        {
            if (string.IsNullOrWhiteSpace(exerciseSearchText))
            {
                return allExercises.OrderBy(e => e.Nombre).Take(8).ToList();
            }

            string queryNorm = NormalizeText(exerciseSearchText);
            string[] queryTokens = queryNorm.Split(' ', StringSplitOptions.RemoveEmptyEntries);

            return allExercises
                .Select(e => new
                {
                    Ejercicio = e,
                    Score = ComputeSimilarityScore(e, queryNorm, queryTokens)
                })
                .Where(x => x.Score > 0)
                .OrderByDescending(x => x.Score)
                .ThenBy(x => x.Ejercicio.Nombre.Length)
                .Select(x => x.Ejercicio)
                .ToList();
        }
    }

    private static int ComputeSimilarityScore(Ejercicio ej, string queryNorm, string[] queryTokens)
    {
        string nameNorm = NormalizeText(ej.Nombre);
        string groupNorm = NormalizeText(ej.GrupoMuscular);
        string[] nameTokens = nameNorm.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (nameNorm == queryNorm)
            return 2000;

        int score = 0;

        if (nameNorm.StartsWith(queryNorm, StringComparison.Ordinal))
            score += 1200;
        else if (nameNorm.Contains(queryNorm, StringComparison.Ordinal))
            score += 800;

        int matchedTokens = 0;
        foreach (var qt in queryTokens)
        {
            if (nameTokens.Any(nt => nt.StartsWith(qt, StringComparison.Ordinal)))
            {
                score += 350;
                matchedTokens++;
            }
            else if (nameNorm.Contains(qt, StringComparison.Ordinal))
            {
                score += 220;
                matchedTokens++;
            }
            else if (groupNorm.StartsWith(qt, StringComparison.Ordinal))
            {
                score += 150;
                matchedTokens++;
            }
            else
            {
                int bestDist = nameTokens.Select(nt => LevenshteinDistance(nt, qt)).DefaultIfEmpty(99).Min();
                if (qt.Length >= 3 && bestDist <= 1)
                {
                    score += 160;
                    matchedTokens++;
                }
                else if (qt.Length >= 5 && bestDist <= 2)
                {
                    score += 90;
                    matchedTokens++;
                }
            }
        }

        if (matchedTokens == queryTokens.Length && queryTokens.Length > 1)
        {
            score += 400;
        }

        if (score == 0 && queryTokens.Length == 1 && queryNorm.Length >= 2)
        {
            string initials = string.Concat(nameTokens.Where(t => t.Length > 0).Select(t => t[0]));
            if (initials.Contains(queryNorm, StringComparison.Ordinal))
            {
                score += 300;
            }
        }

        return score;
    }

    private static string NormalizeText(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        string normalized = input.Trim().ToLowerInvariant().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(normalized.Length);
        foreach (char c in normalized)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
            {
                sb.Append(c);
            }
        }
        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    private static int LevenshteinDistance(string a, string b)
    {
        int n = a.Length;
        int m = b.Length;
        var d = new int[n + 1, m + 1];
        for (int i = 0; i <= n; i++) d[i, 0] = i;
        for (int j = 0; j <= m; j++) d[0, j] = j;

        for (int i = 1; i <= n; i++)
        {
            for (int j = 1; j <= m; j++)
            {
                int cost = a[i - 1] == b[j - 1] ? 0 : 1;
                d[i, j] = Math.Min(
                    Math.Min(d[i - 1, j] + 1, d[i, j - 1] + 1),
                    d[i - 1, j - 1] + cost);
            }
        }
        return d[n, m];
    }

    private string GetFlowStateCss() => flowState switch
    {
        FlowState.TypingExercise => "state-exercise",
        FlowState.TypingSeries or FlowState.TypingReps => "state-series",
        FlowState.TypingLabel => "state-label",
        FlowState.WaitingCommand => "state-waiting",
        _ => "state-idle"
    };

    private string GetFlowStateTitle() => flowState switch
    {
        FlowState.NotStarted => $"Presiona 'Crear Rutina' o [{KeyConfig.SelectKey.Display}] para comenzar en Día 1",
        FlowState.TypingExercise => $"Escribiendo Ejercicio en {RoutineState.ActiveDia?.Nombre} ([{KeyConfig.SelectKey.Display}] para insertar)",
        FlowState.TypingSeries => $"Escribe las Series y presiona [{KeyConfig.SelectKey.Display}]",
        FlowState.TypingReps => $"Escribe las Repeticiones y presiona [{KeyConfig.SelectKey.Display}]",
        FlowState.TypingLabel => $"Escribiendo Etiqueta en {RoutineState.ActiveDia?.Nombre} ([{KeyConfig.SelectKey.Display}] para guardar)",
        FlowState.WaitingCommand => $"Esperando comando: [{KeyConfig.ExerciseKey.Display}] Ejercicio  |  [{KeyConfig.LabelKey.Display}] Etiqueta  |  [{KeyConfig.NextDayKey.Display}] Siguiente Día",
        _ => string.Empty
    };

    private async Task OpenPdfModal()
    {
        if (!RoutineState.RoutineItems.Any())
        {
            await JS.InvokeVoidAsync("alert", "Agrega al menos un ejercicio o etiqueta antes de exportar el PDF.");
            return;
        }
        showPdfModal = true;
    }

    private async Task ExportPdfAsync()
    {
        showPdfModal = false;
        try
        {
            string finalTitle = string.IsNullOrWhiteSpace(pdfTitle) ? "Mi Plan de Entrenamiento" : pdfTitle.Trim();
            var bytes = PdfService.GenerateRoutinePdf(RoutineState.RoutineItems, RoutineState.Dias, finalTitle);
            if (bytes == null || bytes.Length == 0) return;

            string safeTitle = string.Join("_", finalTitle.Split(Path.GetInvalidFileNameChars(), StringSplitOptions.RemoveEmptyEntries)).Trim();
            if (string.IsNullOrWhiteSpace(safeTitle)) safeTitle = "Rutina";

            string desktopDir = Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory);
            if (string.IsNullOrWhiteSpace(desktopDir) || !Directory.Exists(desktopDir))
            {
                desktopDir = FileSystem.CacheDirectory;
            }

            string fileName = $"{safeTitle}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            string fullPath = Path.Combine(desktopDir, fileName);
            await File.WriteAllBytesAsync(fullPath, bytes);

            Process.Start(new ProcessStartInfo
            {
                FileName = fullPath,
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al exportar PDF: {ex.Message}");
        }
    }
}
